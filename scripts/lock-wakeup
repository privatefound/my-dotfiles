#!/usr/bin/env bash
# Effetto "Wake up, Neo…" per la schermata di blocco (hyprlock, label cmd[update:…]).
# Ogni chiamata stampa il testo da mostrare in quel momento, calcolato dal tempo trascorso
# dall'avvio di hyprlock: le frasi si scrivono una lettera alla volta e si sostituiscono,
# l'ultima resta con il cursore che lampeggia.
# (ELAPSED_MS=… per provarlo senza bloccare lo schermo)
set -u

if [ -z "${ELAPSED_MS:-}" ]; then
    pid=$(pgrep -xn hyprlock) || exit 0
    read -r up _ </proc/uptime
    start=$(awk '{ print $22 }' "/proc/$pid/stat")          # in tick (1/100 s)
    ELAPSED_MS=$(( (${up/./} - start) * 10 ))
fi
t=$ELAPSED_MS

# frase | da quando (ms) | fino a quando (ms, 0 = per sempre)
lines=(
    "Wake up, Neo...|600|4800"
    "The Matrix has you...|5200|9800"
    "Follow the white rabbit.|10200|14800"
    "Knock, knock, Neo.|15200|0"
)
speed=85   # ms per lettera

cursor="█"
(( (t / 500) % 2 )) && cursor=" "

for l in "${lines[@]}"; do
    IFS='|' read -r text from to <<<"$l"
    (( t < from )) && break
    (( to > 0 && t >= to )) && continue
    n=$(( (t - from) / speed ))
    (( n > ${#text} )) && n=${#text}
    # mentre scrive il cursore resta acceso
    (( n < ${#text} )) && cursor="█"
    # spazi in coda fino alla lunghezza della frase: il testo è centrato e così non si sposta
    pad=$(( ${#text} - n ))
    printf '%s%s%*s\n' "${text:0:n}" "$cursor" "$pad" ""
    exit 0
done
# prima della prima frase o nella pausa tra due frasi: solo il cursore
printf '%s\n' "$cursor"

-- Copia in monitors.lua e adatta (oppure lascia che Monique lo generi).
-- hyprctl monitors  → nomi e descrizioni dei tuoi monitor

hl.monitor({
  output = "eDP-1",
  mode = "preferred",
  position = "0x0",
  scale = 1,
})

